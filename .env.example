# Set these in your hosting dashboard (Vercel > Project > Settings > Environment Variables).
# They are used only by api/notify.js on the server — never exposed to the browser.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
NOTIFY_FROM="Site Alerts <alerts@your-verified-domain.com>"
# Optional – defaults to francis@creativedevlabs.com
NOTIFY_TO=francis@creativedevlabs.com
